# ブラウザ側: Google Maps JavaScript API 用（公開されるキー。HTTPリファラー制限を推奨）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# サーバー側: Google Places API (New) 用（公開されない。API制限で Places API (New) のみ許可を推奨）
GOOGLE_MAPS_API_KEY=

# 任意: Cloud Console で作成した Map ID（未設定なら DEMO_MAP_ID を使用）
NEXT_PUBLIC_GOOGLE_MAP_ID=

# 任意: 国土交通省「不動産情報ライブラリ」API キー（無料・要申請 https://www.reinfolib.mlit.go.jp/api/request/ ）
# 用途地域・建蔽率/容積率・防火地域・学区・人口の表示に必要。未設定でも他の機能は動く
REINFOLIB_API_KEY=
